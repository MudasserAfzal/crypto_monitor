# =============================================================================
# Crypto Signal Platform - Environment Configuration
# Copy to .env and fill in keys. Never commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME=CryptoSignal
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://crypto:crypto@localhost:5432/crypto_signals
DATABASE_URL_SYNC=postgresql://crypto:crypto@localhost:5432/crypto_signals

# --- Redis (cache + pub/sub + Celery broker) ---
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Analysis defaults ---
DEFAULT_SYMBOLS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,AVAX,DOT,LINK,MATIC,UNI,ATOM,LTC,NEAR
ANALYSIS_TIMEFRAMES=1h,4h,1d,1w
ANALYSIS_TIMEFRAMES_FOR_SIGNALS=1d,4h
SIGNAL_SCHEDULE_CRON=0 8 * * *

# Local file storage (no database required)
FETCH_ALL_COINS=true
COINGECKO_MARKET_PAGES=4
SIGNAL_UNIVERSE_SIZE=50
PERSIST_OHLCV=true


# =============================================================================
# MARKET DATA APIs
# =============================================================================

# CoinGecko (free tier — no key required for public endpoints)
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# CoinMarketCap
COINMARKETCAP_API_KEY=
COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com/v1

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com

# Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_BASE_URL=https://api.kraken.com

# KuCoin
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
KUCOIN_BASE_URL=https://api.kucoin.com

# Yahoo Finance (yfinance — no key)
YAHOO_FINANCE_ENABLED=true

# =============================================================================
# SENTIMENT & SOCIAL APIs
# =============================================================================

# Reddit (PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CryptoSignalBot/1.0

# Twitter/X API v2
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# LunarCrush
LUNARCRUSH_API_KEY=
LUNARCRUSH_BASE_URL=https://lunarcrush.com/api4

# Santiment
SANTIMENT_API_KEY=
SANTIMENT_BASE_URL=https://api.santiment.net

# Google Trends (pytrends — no key)
GOOGLE_TRENDS_ENABLED=true

# Fear & Greed (Alternative.me — no key)
FEAR_GREED_BASE_URL=https://api.alternative.me/fng

# =============================================================================
# ON-CHAIN & ANALYTICS APIs
# =============================================================================

GLASSNODE_API_KEY=
GLASSNODE_BASE_URL=https://api.glassnode.com/v1

COVALENT_API_KEY=
COVALENT_BASE_URL=https://api.covalenthq.com/v1

DUNE_API_KEY=
DUNE_BASE_URL=https://api.dune.com/api/v1

ARKHAM_API_KEY=
ARKHAM_BASE_URL=https://api.arkhamintelligence.com

ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/api

BLOCKCHAIR_API_KEY=
BLOCKCHAIR_BASE_URL=https://api.blockchair.com

# =============================================================================
# NEWS & MACRO APIs
# =============================================================================

NEWSAPI_KEY=
NEWSAPI_BASE_URL=https://newsapi.org/v2

CRYPTOPANIC_API_KEY=
CRYPTOPANIC_BASE_URL=https://cryptopanic.com/api/v1

FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# FRED (Federal Reserve Economic Data)
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred

# =============================================================================
# ALTERNATIVE DATA
# =============================================================================

GITHUB_TOKEN=
GITHUB_BASE_URL=https://api.github.com

DEFILLAMA_BASE_URL=https://api.llama.fi

# =============================================================================
# ALERTS
# =============================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# =============================================================================
# SIGNAL WEIGHTS (must sum to 1.0)
# =============================================================================
WEIGHT_TECHNICAL=0.40
WEIGHT_SENTIMENT=0.20
WEIGHT_ONCHAIN=0.20
WEIGHT_VOLUME=0.10
WEIGHT_MACRO=0.10
